#!/bin/sh
set -eu

fc_data_dir="$HOME/.local/share/framecolor"
fc_manifest="$fc_data_dir/layer/vkBasalt.json"
fc_disabled="$fc_manifest.disabled"
fc_legacy_unit="$HOME/.config/systemd/user/steamvr.service.d/90-framecolor-vkbasalt.conf"
fc_guard_limit="$HOME/.config/framecolor/guard-failure-limit"
fc_guard_failures="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/framecolor/failed-starts"

case "${1:-}" in
    enable)
        if [ -e "$fc_legacy_unit" ]; then
            printf 'An older FrameColor Vulkan test is active: %s\n' "$fc_legacy_unit" >&2
            exit 1
        fi
        if [ "$(steamvr path)" != /opt/steamvr ]; then
            printf 'SteamVR must use the stock /opt/steamvr runtime.\n' >&2
            exit 1
        fi
        [ -f "$fc_data_dir/lib/libvkbasalt.so" ] || { printf 'Vulkan layer is not installed.\n' >&2; exit 1; }
        if [ -f "$fc_disabled" ]; then mv "$fc_disabled" "$fc_manifest"; fi
        [ -f "$fc_manifest" ] || { printf 'Vulkan layer manifest is missing.\n' >&2; exit 1; }
        rm -f "$fc_guard_failures"
        systemctl --user enable framecolor.service
        systemctl --user restart steamvr.service
        systemctl --user start framecolor.service
        printf 'FrameColor Vulkan correction and dashboard enabled. If SteamVR fails to start, the guard disables the layer.\n'
        ;;
    disable)
        # Stop and disable the dashboard before restarting SteamVR. Otherwise
        # steamvr.service would start it again via its WantedBy dependency.
        systemctl --user disable --now framecolor.service
        if [ -f "$fc_manifest" ]; then mv "$fc_manifest" "$fc_disabled"; fi
        rm -f "$fc_guard_failures"
        systemctl --user restart steamvr.service
        printf 'FrameColor Vulkan correction and dashboard disabled. Saved settings are unchanged.\n'
        ;;
    status)
        if [ -f "$fc_manifest" ]; then printf 'Vulkan correction: enabled\n';
        elif [ -f "$fc_disabled" ]; then printf 'Vulkan correction: disabled\n';
        else printf 'Vulkan correction: not installed\n'; fi
        printf 'Dashboard service: %s\n' "$(systemctl --user is-active framecolor.service || true)"
        printf 'Dashboard autostart: %s\n' "$(systemctl --user is-enabled framecolor.service || true)"
        printf 'SteamVR runtime: %s\n' "$(steamvr path)"
        printf 'SteamVR service: %s\n' "$(systemctl --user is-active steamvr.service || true)"
        fc_limit=$(cat "$fc_guard_limit" 2>/dev/null || true)
        case "$fc_limit" in 3) ;; *) fc_limit=1 ;; esac
        fc_count=$(cat "$fc_guard_failures" 2>/dev/null || true)
        case "$fc_count" in *[!0-9]*|'') fc_count=0 ;; esac
        printf 'Startup guard: disable after %s failed launch(es); current count %s\n' "$fc_limit" "$fc_count"
        if [ -e "$fc_legacy_unit" ]; then printf 'Warning: older Vulkan test drop-in is active.\n'; fi
        ;;
    doctor)
        fc_ok=true
        if [ "$(uname -m)" != aarch64 ]; then printf 'FAIL: not ARM64.\n'; fc_ok=false; fi
        if [ "$(steamvr path)" != /opt/steamvr ]; then printf 'FAIL: SteamVR is not using /opt/steamvr.\n'; fc_ok=false; fi
        if [ ! -f "$fc_data_dir/lib/libvkbasalt.so" ]; then printf 'FAIL: layer library missing.\n'; fc_ok=false; fi
        if [ ! -f "$fc_manifest" ] && [ ! -f "$fc_disabled" ]; then
            printf 'FAIL: layer manifest missing.\n'; fc_ok=false
        fi
        if [ -e "$fc_legacy_unit" ]; then printf 'FAIL: older Vulkan test drop-in is active.\n'; fc_ok=false; fi
        if [ "$fc_ok" = true ]; then printf 'FrameColor preflight: OK\n'; else exit 1; fi
        ;;
    guard)
        case "${2:-}" in
            1|3)
                install -d -m 700 "$(dirname "$fc_guard_limit")"
                printf '%s\n' "$2" > "$fc_guard_limit.tmp"
                mv "$fc_guard_limit.tmp" "$fc_guard_limit"
                rm -f "$fc_guard_failures"
                printf 'Startup guard will disable FrameColor after %s consecutive failed launch(es).\n' "$2"
                ;;
            status)
                "$0" status
                ;;
            *) printf 'Usage: framecolorctl guard 1|3|status\n' >&2; exit 2 ;;
        esac
        ;;
    *)
        printf 'Usage: framecolorctl enable|disable|status|doctor|guard 1|3|status\n' >&2
        exit 2
        ;;
esac
